# Copy this file to .env and fill in the values for your RunPod deployment.

# --- Server-side (set these as environment variables on the RunPod pod) ---
MODEL_ID=Qwen/Qwen-Image-2.1
# 1 = enable_model_cpu_offload() for GPUs with less VRAM (slower)
CPU_OFFLOAD=0
DEFAULT_STEPS=40
MAX_INPUT_DIM=2048
# Only needed if the model repo is gated on Hugging Face.
HF_TOKEN=

# --- Shared (set on the pod AND used by the frontend) ---
# Bearer token required by /generate. Leave empty to disable auth.
API_KEY=

# --- Client-side (used by frontend/app.py) ---
# Pod: https://<pod-id>-8000.proxy.runpod.net
RUNPOD_BASE_URL=https://<pod-id>-8000.proxy.runpod.net
